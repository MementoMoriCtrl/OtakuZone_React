{
  "name": "otakuzone-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "check:http": "node scripts/check-http.js",
    "db:migrate": "node scripts/migrate.js",
    "db:check": "node scripts/check-db.js",
    "db:verify": "node scripts/verify-db.js",
    "db:verify:http": "node scripts/verify-db-http.js",
    "auth:verify": "node scripts/verify-auth.js",
    "auth:secret": "node scripts/init-auth-secret.js",
    "commerce:verify": "node scripts/verify-commerce.js",
    "admin:verify": "node scripts/close-phase7.js --admin",
    "admin:schema": "node scripts/apply-admin-schema.js",
    "quality:verify": "node scripts/close-phase7.js --admin --quality",
    "anime:verify": "node scripts/check-anilist.js",
    "anime:verify:browser": "node scripts/close-phase7.js --anilist --anilist-only"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie": "2.0.2",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  }
}
