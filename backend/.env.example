NODE_ENV=development
# Solo desarrollo. Producción usa variables del hosting y no carga este archivo.
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Ruta relativa a backend/, no al directorio desde el que ejecutas Node.
DEMO_DATA_PATH=../mock/db.json

# Sin fallback automático: demo conserva el fixture; mysql usa la base migrada.
CATALOG_SOURCE=demo
DB_HOST=127.0.0.1
# mysql es el valor predeterminado; no cambiar el .env privado para esta etapa.
DB_ENGINE=mysql
DB_PORT=3306
DB_NAME=otakuzone_db
DB_USER=otakuzone_app
DB_PASSWORD=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=5000
# Solo DB_ENGINE=tidb: retiro inactivo y edad máxima suave, sin cortar transacciones.
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_MAX_LIFETIME_MS=300000
DB_SSL=false
# Opcional: certificado CA PEM del proveedor; solo con DB_SSL=true.
DB_SSL_CA=
TRUST_PROXY=false

# Auth necesita MySQL migrado. Generar JWT_SECRET localmente, nunca versionarlo.
AUTH_ENABLED=true
JWT_SECRET=
JWT_TTL_SECONDS=1800
BCRYPT_ROUNDS=12
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=900000
