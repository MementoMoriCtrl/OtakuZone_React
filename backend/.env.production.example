# Plantilla NO operativa: faltan dominio, proveedor y credenciales.
# Introducir variables en Render; no copiar secretos al repositorio.
NODE_ENV=production
HOST=0.0.0.0
# PORT lo asigna Render. No definir aquí un puerto fijo.
# Orígenes HTTPS exactos del frontend confirmado, separados por comas, sin rutas.
CORS_ORIGINS=
# Sustituir por IP/CIDR de proxies verificados antes de publicar en Render.
# false mantiene el comportamiento local seguro, pero no identifica clientes tras proxy.
TRUST_PROXY=false
CATALOG_SOURCE=mysql
AUTH_ENABLED=true
DB_HOST=
# mysql por defecto. Seleccionar tidb solo tras aprobar email/bootstrap y preflight real.
DB_ENGINE=mysql
# Para Starter usar el puerto real de Connect (normalmente 4000), no este default MySQL.
DB_PORT=3306
# Restricción actual del migrador; no ejecutar migraciones en esta etapa.
DB_NAME=otakuzone_db
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_MAX_LIFETIME_MS=300000
DB_SSL=true
# Opcional: PEM CA si el proveedor no usa una CA reconocida por Node.
# Acepta saltos reales o secuencias literales \n; nunca desactivar verificación TLS.
DB_SSL_CA=
# Secreto aleatorio criptográfico >=64 caracteres, estable entre réplicas.
JWT_SECRET=
JWT_TTL_SECONDS=1800
BCRYPT_ROUNDS=12
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=900000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
